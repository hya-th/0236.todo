<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting"
                    android:fontFamily="@font/dunggeunmo"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_greeting_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="@string/notifications"
                android:padding="9dp"
                android:src="@drawable/ic_bell" />

        </LinearLayout>

        <!-- 오늘의 냥이 hero window -->
        <LinearLayout
            android:id="@+id/cardTodayCat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout style="@style/WindowTitleBar">

                <TextView
                    style="@style/WindowTitleText"
                    android:text="오늘의 냥이.EXE" />

                <ImageView
                    style="@style/WindowDots"
                    android:contentDescription="@string/home_today_cat"
                    android:src="@drawable/ic_window_dots" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/home_today_cat"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cat_blue" />

                <TextView
                    android:id="@+id/tvProgressCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/dunggeunmo"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="오늘 할 일 3 / 5 완료" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:indicatorColor="@color/pink"
                    app:trackColor="@color/pink_bg"
                    app:trackCornerRadius="100dp"
                    app:trackThickness="10dp" />

                <TextView
                    android:id="@+id/tvProgressCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_progress_caption"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Navigation cards -->
        <LinearLayout
            android:id="@+id/cardAllTodo"
            style="@style/HomeNavCard"
            android:layout_marginTop="16dp">

            <ImageView
                style="@style/HomeNavIcon"
                android:contentDescription="@string/home_all_todo"
                android:src="@drawable/cat_silhouette" />

            <TextView
                style="@style/HomeNavText"
                android:text="@string/home_all_todo" />

            <ImageView
                style="@style/HomeNavChevron"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMonthly"
            style="@style/HomeNavCard"
            android:layout_marginTop="12dp">

            <ImageView
                style="@style/HomeNavIcon"
                android:contentDescription="@string/home_monthly"
                android:src="@drawable/cat_folder" />

            <TextView
                style="@style/HomeNavText"
                android:text="@string/home_monthly" />

            <ImageView
                style="@style/HomeNavChevron"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardWeekly"
            style="@style/HomeNavCard"
            android:layout_marginTop="12dp">

            <ImageView
                style="@style/HomeNavIcon"
                android:contentDescription="@string/home_weekly"
                android:src="@drawable/cat_calendar" />

            <TextView
                style="@style/HomeNavText"
                android:text="@string/home_weekly" />

            <ImageView
                style="@style/HomeNavChevron"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHomeCat"
            android:layout_width="wrap_content"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="60dp"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/home_today_cat"
            android:scaleType="fitCenter" />

    </LinearLayout>

</ScrollView>
