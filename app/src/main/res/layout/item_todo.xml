<?xml version="1.0" encoding="utf-8"?>
<!-- 설명: 할 일 목록 항목(체크/제목/색점/시간/펼침 + 메모 드롭다운) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="2dp"
    android:orientation="vertical">

    <!-- Card row -->
    <LinearLayout
        android:id="@+id/cardRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:elevation="1dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingVertical="12dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonCompat="@drawable/btn_todo_check"
            app:buttonTint="@null" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="아침 스트레칭 하기" />

        <View
            android:id="@+id/vColorDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="10:00"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnExpand"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_memo"
            android:src="@drawable/ic_chevron_down" />

    </LinearLayout>

    <!-- Memo dropdown (filled in code) -->
    <LinearLayout
        android:id="@+id/memoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
