<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.a0236todo.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/catStatusFragment"
        android:name="com.example.a0236todo.ui.cat.CatStatusFragment"
        android:label="@string/cat_status_title"
        tools:layout="@layout/fragment_cat_status" />

    <fragment
        android:id="@+id/todoFragment"
        android:name="com.example.a0236todo.ui.todo.TodoFragment"
        android:label="@string/nav_todo"
        tools:layout="@layout/fragment_todo" />

    <fragment
        android:id="@+id/todoDetailFragment"
        android:name="com.example.a0236todo.ui.todo.TodoDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_todo_detail">
        <argument
            android:name="todoId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.a0236todo.ui.calendar.CalendarFragment"
        android:label="@string/nav_calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/calendarDetailFragment"
        android:name="com.example.a0236todo.ui.calendar.CalendarDetailFragment"
        android:label="@string/nav_calendar"
        tools:layout="@layout/fragment_calendar_detail">
        <argument
            android:name="dateKey"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/weeklyFragment"
        android:name="com.example.a0236todo.ui.weekly.WeeklyFragment"
        android:label="@string/nav_weekly"
        tools:layout="@layout/fragment_weekly" />

</navigation>
